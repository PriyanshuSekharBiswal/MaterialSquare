# Copy to root .env.production. Never commit the filled file.
# Domains only, without https:// or paths; both DNS records must point to the server.
SITE_DOMAIN=website.example.com
ADMIN_DOMAIN=staff.example.com
# Use separate randomly generated hexadecimal secrets (URL-safe for DATABASE_URL).
POSTGRES_PASSWORD=
JWT_SECRET=
# Configure the 2Factor key + approved SMS sender ID, or an SMS webhook.
TWOFACTOR_API_KEY=
TWOFACTOR_SENDER_ID=
TWOFACTOR_SMS_MESSAGE=Material Square: Your verification code is XXXX. It expires in 5 minutes. Do not share it with anyone.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
