# Copy to root .env.production. Never commit the filled file.
# Domain only, without https:// or paths; DNS must point to the server.
SITE_DOMAIN=website.example.com
# Use unique generated secrets. Generate JWT_SECRET with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a separate URL-safe hexadecimal secret for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
# Keep the generated hex password outside the repository, owned root:1000 with mode 640.
# The API container runs as UID/GID 1000. See deployment/README.md.
REDIS_PASSWORD_FILE=/etc/material-square/redis-password
JWT_SECRET=
MSG91_AUTHKEY=
# Optional outbound notifications. If configured, production requires an HTTPS endpoint and a unique token of at least 32 bytes.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
MSG91_SMS_TEMPLATE_ID_QUOTE_PUBLISHED=
MSG91_SMS_TEMPLATE_ID_QUOTE_EXPIRY_REMINDER=
MSG91_SMS_TEMPLATE_ID_QUOTE_FOLLOW_UP=
MSG91_SMS_TEMPLATE_ID_DISPATCH_UPDATE=
# Public MSG91 widget values embedded in the customer website at build time.
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_URL=
