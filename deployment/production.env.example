# Copy to root .env.production. Never commit the filled file.
# Domain only, without https:// or paths; DNS must point to the server.
SITE_DOMAIN=website.example.com
# Use separate randomly generated hexadecimal secrets (URL-safe for DATABASE_URL).
POSTGRES_PASSWORD=
JWT_SECRET=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_URL=
