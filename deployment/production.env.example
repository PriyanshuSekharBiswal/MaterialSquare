# Copy to root .env.production. Never commit the filled file.
# Domains only, without https:// or paths; both DNS records must point to the server.
SITE_DOMAIN=website.example.com
ADMIN_DOMAIN=staff.example.com
# Use separate randomly generated hexadecimal secrets (URL-safe for DATABASE_URL).
POSTGRES_PASSWORD=
JWT_SECRET=
# MSG91 server Authkey is used only to verify the OTP Widget access token.
MSG91_AUTHKEY=
