{
  "name": "@material-square/types",
  "version": "1.0.0",
  "private": true,
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc --module commonjs --moduleResolution node --outDir dist-cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./catalog-data": {
      "types": "./dist/catalog-data.d.ts",
      "import": "./dist/catalog-data.js",
      "require": "./dist-cjs/catalog-data.js"
    }
  }
}
