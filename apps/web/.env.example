VITE_API_URL=/api
# Canonical customer-site origin used by generated sitemap and crawler metadata.
VITE_PUBLIC_SITE_URL=https://your-customer-domain.example
# Exact origin of the staff app allowed to send private website draft previews.
VITE_ADMIN_APP_ORIGIN=https://staff.your-customer-domain.example
# Public OTP Widget settings from MSG91. The widget token is designed for browser use;
# never put the server Authkey here.
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
