{
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build --workspace=@material-square/types && npm run build --workspace=@material-square/web",
  "outputDirectory": "dist",
  "functions": { "api/*.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/robots.txt", "destination": "/api/seo?__route=robots" },
    { "source": "/sitemap.xml", "destination": "/api/seo?__route=sitemap" },
    { "source": "/", "destination": "/api/seo?__route=homepage" },
    { "source": "/blogs", "destination": "/api/seo?__route=blog-index" },
    { "source": "/contact", "destination": "/api/seo?__route=contact" },
    { "source": "/why-us", "destination": "/api/seo?__route=site-page&path=/why-us" },
    { "source": "/guides", "destination": "/api/seo?__route=site-page&path=/guides" },
    { "source": "/get-quote", "destination": "/api/seo?__route=site-page&path=/get-quote" },
    { "source": "/marketplace", "destination": "/api/seo?__route=marketplace" },
    { "source": "/experts", "destination": "/api/seo?__route=experts" },
    { "source": "/locations/:slug", "destination": "/api/seo?__route=location&slug=:slug" },
    { "source": "/blogs/:slug", "destination": "/api/seo?__route=blog&slug=:slug" },
    { "source": "/product/:productId", "destination": "/api/seo?__route=product&productId=:productId" },
    { "source": "/privacy", "destination": "/api/spa?path=/privacy" },
    { "source": "/terms", "destination": "/api/spa?path=/terms" },
    { "source": "/((?!api).*)", "destination": "/api/spa?path=/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/__app-shell.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/account",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/account/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/material-list",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
