{
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build --workspace=@material-square/types && npm run build --workspace=@material-square/web",
  "outputDirectory": "dist",
  "functions": { "api/*.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blogs/:slug", "destination": "/api/blog-preview?slug=:slug" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
