{
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build --workspace=@material-square/types && npm run build --workspace=@material-square/admin",
  "outputDirectory": "dist",
  "functions": { "api/proxy.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
