# Local development only. Replace every value before deployment.
DATABASE_URL=postgresql://material_square:local-development-only@127.0.0.1:55432/material_square_dev
# Optional API integration suite: use a separate, migrated test database.
# TEST_DATABASE_URL=postgresql://material_square:local-development-only@127.0.0.1:55432/material_square_test
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://material-square.localtest.me:5175
# Customer phone verification (optional for local public-browsing work).
# Keep the auth key private on the API; widget settings are used in the web build.
MSG91_AUTHKEY=
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
REDIS_URL=redis://127.0.0.1:6379
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://127.0.0.1:9000
AWS_S3_BUCKET=material-square-assets
AWS_ACCESS_KEY_ID=local-material-square
AWS_SECRET_ACCESS_KEY=local-development-only
# Local public asset path is proxied by Vite so HTTPS storefront pages never
# load object-storage files as mixed content.
AWS_S3_PUBLIC_URL=https://material-square.localtest.me:5175/material-square-assets
# Notification adapter receives {type, ...data}; use Idempotency-Key to deduplicate retries.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
# Seller details printed on generated quotation PDFs.
QUOTE_SELLER_NAME=Material Square
QUOTE_SELLER_ADDRESS=
QUOTE_SELLER_PHONE=
QUOTE_SELLER_EMAIL=
QUOTE_SELLER_GSTIN=
