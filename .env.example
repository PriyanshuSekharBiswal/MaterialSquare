# Local development only. Replace every value before deployment.
DATABASE_URL=postgresql://material_square:local-development-only@127.0.0.1:5432/material_square
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
REDIS_URL=redis://127.0.0.1:6379
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://127.0.0.1:9000
AWS_S3_BUCKET=material-square-assets
AWS_ACCESS_KEY_ID=local-material-square
AWS_SECRET_ACCESS_KEY=local-development-only
AWS_S3_PUBLIC_URL=http://127.0.0.1:9000/material-square-assets
# Configure exactly one SMS provider for normal development/production.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# 2Factor direct text-SMS provider. Keep credentials server-side only.
TWOFACTOR_API_KEY=
TWOFACTOR_SENDER_ID=
# Must match the approved SMS template; XXXX is replaced with the OTP.
TWOFACTOR_SMS_MESSAGE=Material Square: Your verification code is XXXX. It expires in 5 minutes. Do not share it with anyone.
# Notification adapter receives {type, ...data}; use Idempotency-Key to deduplicate retries.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
# Seller details printed on generated quotation PDFs.
QUOTE_SELLER_NAME=Material Square
QUOTE_SELLER_ADDRESS=
QUOTE_SELLER_PHONE=
QUOTE_SELLER_EMAIL=
QUOTE_SELLER_GSTIN=
